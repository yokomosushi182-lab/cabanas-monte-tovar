---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { IMG } from "../data/images";
import { EVENTS, waLink } from "../data/site";
---

<Layout
  title="Eventos y temporadas — Cabañas Monte Tovar"
  description="Temporadas y eventos en la Colonia Tovar para hospedarte en Cabañas Monte Tovar, como el Oktoberfest en el Hotel Freiburg."
>
  <section class="mx-auto max-w-6xl px-5 pb-6 pt-16 md:px-8 md:pt-24">
    <p class="eyebrow">Temporadas</p>
    <h1 class="mt-3 max-w-xl font-display text-4xl font-semibold sm:text-5xl">
      Eventos en la Colonia
    </h1>
    <p class="mt-4 max-w-lg font-body text-tinta/75">
      Algunas fechas del año valen la pena reservar con anticipación. Estas son las que se
      vienen.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-10 md:px-8 md:py-14">
    {
      EVENTS.length === 0 ? (
        <p class="rounded-[var(--radius-cabin)] bg-oliva/8 p-8 text-center text-tinta/70">
          Todavía no hay temporadas anunciadas. Escríbenos por WhatsApp y te avisamos apenas
          salga una fecha.
        </p>
      ) : (
        <div class="space-y-10">
          {EVENTS.map((event) => (
            <article class="grid gap-8 overflow-hidden rounded-[var(--radius-cabin-lg)] bg-white/40 ring-1 ring-oliva/10 md:grid-cols-[1fr_1.1fr] md:items-center">
              <div>
                <Image src={IMG.fachada} alt={event.name} class="h-auto w-full" />
              </div>
              <div class="p-7 md:p-9">
                {event.status === "próximo" && <p class="eyebrow">Próximamente</p>}
                <h2 class="mt-2 font-display text-2xl font-semibold text-oliva-dark sm:text-3xl">
                  {event.name}
                </h2>
                <p class="mt-2 text-sm font-bold uppercase tracking-wide text-terracota">
                  {event.dates}
                </p>
                <p class="mt-1 text-sm text-tinta/60">{event.location}</p>
                <p class="mt-4 text-tinta/75">{event.description}</p>
                <a
                  href={waLink(`Hola, quiero reservar en Monte Tovar para ${event.name} (${event.dates})`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary mt-6"
                >
                  Reservar para esta fecha
                </a>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>
</Layout>
