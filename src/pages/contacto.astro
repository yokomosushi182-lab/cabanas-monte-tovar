---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { IMG } from "../data/images";
import { SITE, waLink } from "../data/site";
---

<Layout
  title="Contacto — Cabañas Monte Tovar"
  description="Escríbenos por WhatsApp o síguenos en Instagram para reservar en Cabañas Monte Tovar, Colonia Tovar, Aragua."
>
  <section class="mx-auto grid max-w-6xl gap-10 px-5 py-16 md:grid-cols-2 md:gap-16 md:px-8 md:py-24">
    <div>
      <p class="eyebrow">Hablemos</p>
      <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">Contacto</h1>
      <p class="mt-5 max-w-md font-body text-tinta/75">
        La forma más rápida de reservar es por WhatsApp — normalmente respondemos el mismo día.
      </p>

      <div class="mt-10 space-y-6">
        <a
          href={waLink("Hola, quiero más información sobre Cabañas Monte Tovar")}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between gap-4 rounded-[var(--radius-cabin)] bg-oliva/8 p-6 transition-colors hover:bg-oliva/14"
        >
          <div>
            <p class="eyebrow">WhatsApp</p>
            <p class="mt-1 font-display text-xl font-semibold text-oliva-dark">+54 9 294 415-7182</p>
          </div>
          <span aria-hidden="true" class="font-display text-2xl text-terracota">→</span>
        </a>

        <a
          href={SITE.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between gap-4 rounded-[var(--radius-cabin)] bg-oliva/8 p-6 transition-colors hover:bg-oliva/14"
        >
          <div>
            <p class="eyebrow">Instagram</p>
            <p class="mt-1 font-display text-xl font-semibold text-oliva-dark">{SITE.instagramHandle}</p>
          </div>
          <span aria-hidden="true" class="font-display text-2xl text-terracota">→</span>
        </a>

        <div class="rounded-[var(--radius-cabin)] bg-oliva/8 p-6">
          <p class="eyebrow">Dirección</p>
          <p class="mt-1 font-display text-xl font-semibold text-oliva-dark">
            Colonia Tovar, Aragua, Venezuela
          </p>
          <p class="mt-1 text-sm text-tinta/65">A 5 minutos del Hotel Freiburg, subiendo hacia la parte más alta.</p>
        </div>
      </div>

      <a href={waLink("Hola, quiero reservar en Cabañas Monte Tovar")} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-10">
        Reservar por WhatsApp
      </a>
    </div>

    <div class="overflow-hidden rounded-[var(--radius-cabin-lg)]">
      <Image
        src={IMG.laguna}
        alt="Laguna y jardín de Cabañas Monte Tovar"
        width={900}
        height={1100}
        class="h-full w-full object-cover"
      />
    </div>
  </section>
</Layout>
