---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { IMG } from "../data/images";
import { CABINS, waLink } from "../data/site";
---

<Layout
  title="Cabañas — Cabañas Monte Tovar"
  description="Conoce las cuatro cabañas de Monte Tovar en la Colonia Tovar: Verde, Amarilla, Azul y Roja. Todas con baño privado."
>
  <section class="mx-auto max-w-6xl px-5 pb-6 pt-16 md:px-8 md:pt-24">
    <p class="eyebrow">Alojamiento</p>
    <h1 class="mt-3 max-w-xl font-display text-4xl font-semibold sm:text-5xl">
      Cuatro cabañas, cuatro maneras de quedarse
    </h1>
    <p class="mt-4 max-w-lg font-body text-tinta/75">
      Todas con baño privado. Escoge según cuántos suben contigo y escríbenos para confirmar
      disponibilidad.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 md:px-8 md:py-16">
    <div class="grid gap-10 md:grid-cols-2">
      {
        CABINS.map((cabin, i) => (
          <article class="overflow-hidden rounded-[var(--radius-cabin-lg)] bg-white/40 ring-1 ring-oliva/10">
            <div class="overflow-hidden">
              <Image
                src={IMG[cabin.image as keyof typeof IMG]}
                alt={cabin.name}
                loading={i < 2 ? "eager" : "lazy"}
                class="h-auto w-full"
              />
            </div>
            <div class="p-7 md:p-8">
              <h2 class="font-display text-2xl font-semibold text-oliva-dark">{cabin.name}</h2>

              <dl class="mt-3">
                <dt class="eyebrow !text-oliva">Capacidad</dt>
                <dd class="mt-1 text-tinta/80">{cabin.capacity}</dd>
              </dl>

              <ul class="mt-4 flex flex-wrap gap-2">
                {cabin.features.map((f) => (
                  <li class="rounded-full bg-oliva/8 px-3 py-1 text-xs font-bold uppercase tracking-wide text-oliva-dark">
                    {f}
                  </li>
                ))}
              </ul>

              <a
                href={waLink(`Hola, quiero consultar disponibilidad para la ${cabin.name} en Monte Tovar`)}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary mt-6 w-full sm:w-auto"
              >
                Consultar disponibilidad
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
