---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { IMG } from "../data/images";

const photos = [
  { key: "chalet-arbol" as const, alt: "Las cabañas asomadas entre los árboles de la montaña", tall: true },
  { key: "fachada" as const, alt: "Fachada de las cabañas de estilo alemán" },
  { key: "terraza" as const, alt: "Terraza con sombrilla y vista al valle" },
  { key: "puerta" as const, alt: "Entrada rústica de una de las cabañitas" },
  { key: "laguna" as const, alt: "Laguna y muro de piedra en el jardín", tall: true },
  { key: "hab-verde" as const, alt: "Habitación acogedora de una de las cabañitas" },
  { key: "comedor" as const, alt: "Comedor de madera con vista al bosque" },
  { key: "bromelia" as const, alt: "Bromelia en el jardín de Monte Tovar" },
  { key: "literas" as const, alt: "Literas de madera en la cabañita para 6" },
  { key: "oveja" as const, alt: "Ovejas pastando cerca de las cabañas" },
  { key: "perezoso" as const, alt: "Perezoso entre las ramas" },
  { key: "sapito" as const, alt: "Sapito sobre una roca cubierta de musgo" },
];
---

<Layout
  title="Galería — Cabañas Monte Tovar"
  description="Fotos de Cabañas Monte Tovar: cabañitas, terrazas, jardines y la fauna de la Colonia Tovar, Aragua."
>
  <section class="mx-auto max-w-6xl px-5 pb-6 pt-16 md:px-8 md:pt-24">
    <p class="eyebrow">Fotos</p>
    <h1 class="mt-3 max-w-xl font-display text-4xl font-semibold sm:text-5xl">Galería</h1>
    <p class="mt-4 max-w-lg font-body text-tinta/75">
      Un vistazo a las cabañitas, el jardín y los vecinos de siempre. Toca cualquier foto para
      verla en grande.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-10 md:px-8 md:py-14">
    <div class="columns-1 gap-4 sm:columns-2 lg:columns-3 [&>*]:mb-4">
      {
        photos.map((p, i) => (
          <button
            type="button"
            class="gallery-item block w-full overflow-hidden rounded-[var(--radius-cabin)] ring-1 ring-oliva/10"
            data-index={i}
          >
            <Image
              src={IMG[p.key]}
              alt={p.alt}
              width={800}
              height={p.tall ? 1000 : 620}
              loading={i < 6 ? "eager" : "lazy"}
              class="w-full object-cover transition-transform duration-500 hover:scale-[1.03]"
            />
          </button>
        ))
      }
    </div>
  </section>

  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-tinta/90 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Foto ampliada"
  >
    <button id="lightbox-close" type="button" class="absolute right-5 top-5 grid h-11 w-11 place-items-center rounded-full bg-crema/10 text-crema" aria-label="Cerrar">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="5" y1="5" x2="19" y2="19"></line>
        <line x1="19" y1="5" x2="5" y2="19"></line>
      </svg>
    </button>
    <button id="lightbox-prev" type="button" class="absolute left-3 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-crema/10 text-crema md:left-6" aria-label="Foto anterior">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button id="lightbox-next" type="button" class="absolute right-3 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-crema/10 text-crema md:right-6" aria-label="Foto siguiente">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-h-[85vh] max-w-full rounded-2xl object-contain" />
  </div>
</Layout>

<script>
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>(".gallery-item"));
  const lightbox = document.getElementById("lightbox");
  const img = document.getElementById("lightbox-img") as HTMLImageElement;
  let current = 0;

  function open(index: number) {
    current = index;
    const source = items[index]?.querySelector("img");
    if (!source || !lightbox) return;
    img.src = source.src;
    img.alt = source.alt;
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function close() {
    lightbox?.classList.add("hidden");
    lightbox?.classList.remove("flex");
    document.body.style.overflow = "";
  }

  function show(delta: number) {
    current = (current + delta + items.length) % items.length;
    open(current);
  }

  items.forEach((el, i) => el.addEventListener("click", () => open(i)));
  document.getElementById("lightbox-close")?.addEventListener("click", close);
  document.getElementById("lightbox-prev")?.addEventListener("click", () => show(-1));
  document.getElementById("lightbox-next")?.addEventListener("click", () => show(1));
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) close();
  });
  document.addEventListener("keydown", (e) => {
    if (lightbox?.classList.contains("hidden")) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowRight") show(1);
    if (e.key === "ArrowLeft") show(-1);
  });
</script>
